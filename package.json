{
    "name": "@fftt-api/typescript-client",
    "version": "2026.7.0",
    "description": "Client TypeScript non-officiel de l'API FFTT 🏓",
    "license": "MIT",
    "repository": {
        "url": "git+https://github.com/fftt-api/typescript-client.git"
    },
    "bin": {
        "serial": "bin/run.mjs"
    },
    "files": [
        "bin",
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "imports": {
        "#/*": "./src/*.ts",
        "#bin/*": "./src/bin/*.ts",
        "#contracts/*": "./src/contracts/*.ts",
        "#core/*": "./src/core/*.ts",
        "#enums/*": "./src/enums/*.ts",
        "#errors/*": "./src/errors/*.ts",
        "#models/*": "./src/models/*.ts",
        "#services/*": "./src/services/*.ts",
        "#utils/*": "./src/utils/*.ts",
        "#tests/*": "./tests/*.ts"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": false
    },
    "scripts": {
        "build": "tsdown",
        "check-exports": "attw --pack . --ignore-rules cjs-resolves-to-esm",
        "ci": "pnpm run build && pnpm run check-exports",
        "dev": "tsdown --watch",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepublishOnly": "pnpm run ci",
        "test": "vitest",
        "test:ci": "vitest --watch=false --coverage",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "entities": "^8.0.0",
        "fast-xml-parser": "^5.8.0",
        "jssha": "^3.3.1",
        "luxon": "^3.7.2",
        "mathjs": "^15.2.0",
        "md5": "^2.3.0",
        "valibot": "^1.4.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.2",
        "@types/luxon": "3.7.1",
        "@types/md5": "2.3.6",
        "@types/node": "25.7.0",
        "@typescript/native-preview": "7.0.0-dev.20260326.1",
        "@vitest/coverage-v8": "4.1.6",
        "oxfmt": "0.49.0",
        "oxlint": "1.64.0",
        "oxlint-tsgolint": "0.22.1",
        "tsdown": "0.22.0",
        "typescript": "6.0.3",
        "vitest": "4.1.6"
    },
    "engines": {
        "node": ">=24.14.0"
    }
}
