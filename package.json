{
    "name": "@fftt-api/typescript-client",
    "version": "1.1.0",
    "description": "Client TypeScript non-officiel de l'API FFTT 🏓",
    "license": "MIT",
    "repository": {
        "url": "git+https://github.com/fftt-api/typescript-client.git"
    },
    "bin": {
        "serial": "bin/run.mjs"
    },
    "files": [
        "bin",
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "imports": {
        "#/*": "./src/*.ts",
        "#bin/*": "./src/bin/*.ts",
        "#contracts/*": "./src/contracts/*.ts",
        "#core/*": "./src/core/*.ts",
        "#enums/*": "./src/enums/*.ts",
        "#errors/*": "./src/errors/*.ts",
        "#models/*": "./src/models/*.ts",
        "#services/*": "./src/services/*.ts",
        "#utils/*": "./src/utils/*.ts",
        "#tests/*": "./tests/*.ts"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": false
    },
    "scripts": {
        "build": "tsdown",
        "changeset": "changeset",
        "check-exports": "attw --pack .",
        "ci": "npm run build && npm run check-exports",
        "dev": "tsdown --watch",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "local-release": "changeset version && changeset publish",
        "prepublishOnly": "npm run ci",
        "test": "vitest",
        "test:ci": "vitest --watch=false --coverage",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "entities": "8.0.0",
        "fast-xml-parser": "5.5.9",
        "jssha": "3.3.1",
        "luxon": "3.7.2",
        "mathjs": "15.1.1",
        "md5": "2.3.0",
        "valibot": "1.3.1"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.2",
        "@changesets/cli": "2.30.0",
        "@types/luxon": "3.7.1",
        "@types/md5": "2.3.6",
        "@types/node": "25.5.0",
        "@typescript/native-preview": "7.0.0-dev.20260326.1",
        "@vitest/coverage-v8": "4.1.2",
        "oxfmt": "0.42.0",
        "oxlint": "1.57.0",
        "oxlint-tsgolint": "0.17.4",
        "tsdown": "0.21.5",
        "typescript": "6.0.2",
        "vitest": "4.1.2"
    },
    "engines": {
        "node": ">=24.14.0"
    }
}
